# Copia este archivo a .env y completa tus llaves. .env nunca entra al repositorio.
# Deja vacía la llave de un proveedor que no uses: scripts/correr_matriz.py se la salta.

# Anthropic (Claude), con créditos.
ANTHROPIC_API_KEY=
# OpenAI (GPT), con créditos.
OPENAI_API_KEY=
# Google AI Studio (Gemini), tiene capa gratis. Se usa con --model google/<modelo>.
GOOGLE_API_KEY=
# Groq (Llama y otros modelos abiertos), tiene capa gratis. Se usa con --model groq/<modelo>.
GROQ_API_KEY=
# Hugging Face Inference Providers, sin GPU. Se usa con --model hf-inference-providers/<organizacion>/<modelo>.
HF_TOKEN=

# Capa 1 (opcional): ruta del binario de Pipelock. Con esto, defense=layer1 usa el firewall real.
# Alternativa: PIPELOCK_URL y PIPELOCK_TOKEN de un Pipelock que ya corre. SCAMSHIELD_CAPA1=referencia lo desactiva.
PIPELOCK_BIN=
